# Root ignores — frontend has its own .gitignore with Angular specifics
# See frontend/.gitignore for /dist, /node_modules, /.angular/cache, etc.

# Keep frontend build artifacts ignored even from root
/frontend/dist
/frontend/node_modules
/frontend/.angular
/frontend/tmp
/frontend/out-tsc

# Node logs
npm-debug.log
yarn-error.log

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# Coverage & misc
coverage
__screenshots__/

# Gemini generated images (prevent accidental commits)
/Gemini*.jpg
/Gemini*.png
/frontend/Gemini*.jpg
/frontend/Gemini*.png

# Environment
.env
.env.local
